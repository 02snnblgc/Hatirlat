<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Hatırlatma Başlığı (Örn: Elektrik Faturası)"
            android:inputType="text" />

        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Açıklama / Detaylı Mesaj"
            android:inputType="textMultiLine"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Kategori (Örn: Faturalar)"
            android:inputType="text"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hedef Tarih ve Saat:"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvSelectedDate"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:textSize="16sp"
            android:background="?android:attr/selectableItemBackground"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Çoklu Hatırlatma Seçenekleri:"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <CheckBox
            android:id="@+id/cbAtTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Olay anında bildir"
            android:checked="true" />

        <CheckBox
            android:id="@+id/cb1HourBefore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 saat önce bildir" />

        <CheckBox
            android:id="@+id/cb1DayBefore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 gün önce bildir" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tekrar Sıklığı:"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <Spinner
            android:id="@+id/spinnerRepeat"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btnSelectRingtone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Özel Alarm Melodisi Seç"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnSaveReminder"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Kaydet ve Planla"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</ScrollView>