<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white">

    <EditText
        android:id="@+id/etTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Hatırlatma Başlığı"
        android:inputType="text"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Açıklama / Detaylar"
        android:inputType="textMultiLine"
        android:layout_marginBottom="12dp"/>

    <Spinner
        android:id="@+id/spinnerCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"/>

    <Spinner
        android:id="@+id/spinnerRepeat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"/>

    <CheckBox
        android:id="@+id/cbNotify1Day"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1 Gün Önce Bildir"/>

    <CheckBox
        android:id="@+id/cbNotify1Hour"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1 Saat Önce Bildir"/>

    <CheckBox
        android:id="@+id/cbNotifyAtTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vakti Geldiğinde Bildir"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kaydet"
        android:padding="12dp"/>

</LinearLayout>
